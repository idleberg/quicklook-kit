{
	"name": "quicklook-kit",
	"version": "0.3.0",
	"description": "Build macOS QuickLook previews with any Vite-based web framework",
	"license": "MIT",
	"keywords": [
		"quicklook",
		"quicklook-plugin",
		"sveltekit",
		"svelte",
		"astro",
		"solid",
		"solid-start",
		"vue",
		"nuxt",
		"angular",
		"analog"
	],
	"type": "module",
	"bin": {
		"quicklook": "./src/cli.ts"
	},
	"exports": {
		".": "./src/config.ts",
		"./vite": "./src/vite.ts",
		"./runtime": "./src/runtime.ts",
		"./virtual": {
			"types": "./src/virtual.d.ts"
		}
	},
	"files": [
		"dist",
		"native",
		"src/virtual.d.ts"
	],
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"build": "tsdown",
		"prepack": "tsdown",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"c12": "3.3.4",
		"jiti": "2.7.0"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"vite": ">=7"
	},
	"publishConfig": {
		"bin": {
			"quicklook": "./dist/cli.mjs"
		},
		"exports": {
			".": {
				"types": "./dist/config.d.mts",
				"default": "./dist/config.mjs"
			},
			"./vite": {
				"types": "./dist/vite.d.mts",
				"default": "./dist/vite.mjs"
			},
			"./runtime": {
				"types": "./dist/runtime.d.mts",
				"default": "./dist/runtime.mjs"
			},
			"./virtual": {
				"types": "./src/virtual.d.ts"
			}
		}
	}
}
