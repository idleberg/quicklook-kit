{
	"name": "quicklook-kit",
	"version": "0.1.1",
	"description": "Build macOS QuickLook previews with any Vite-based web framework",
	"license": "MIT",
	"keywords": [
		"quicklook",
		"quicklook-plugin",
		"sveltekit",
		"svelte",
		"astro",
		"solid",
		"solid-start",
		"vue",
		"nuxt",
		"angular",
		"analog"
	],
	"type": "module",
	"bin": {
		"quicklook": "./src/cli.ts"
	},
	"exports": {
		".": "./src/config.ts",
		"./vite": "./src/vite.ts",
		"./runtime": "./src/runtime.ts",
		"./virtual": {
			"types": "./src/virtual.d.ts"
		}
	},
	"scripts": {
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"c12": "3.3.4",
		"jiti": "2.7.0"
	},
	"devDependencies": {
		"@types/bun": "1.3.9",
		"typescript": "6.0.3",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"vite": ">=7"
	}
}
