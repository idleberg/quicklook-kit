{
	"name": "create-quicklook",
	"version": "0.2.1",
	"description": "Create a macOS QuickLook preview with any Vite-based web framework",
	"license": "MIT",
	"keywords": [
		"quicklook",
		"quicklook-plugin",
		"create",
		"template"
	],
	"type": "module",
	"bin": {
		"create-quicklook": "./dist/index.mjs"
	},
	"files": [
		"dist",
		"files",
		"templates",
		"!templates/*/node_modules",
		"!templates/*/.quicklook",
		"!templates/*/.DS_Store",
		"!templates/*/.svelte-kit",
		"!templates/*/build",
		"!templates/*/.astro",
		"!templates/*/dist",
		"!templates/*/.output",
		"!templates/*/.nitro",
		"!templates/*/.vinxi",
		"!templates/*/.nuxt",
		"!templates/*/.angular"
	],
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"build": "tsdown",
		"prepack": "tsdown",
		"check": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"tsdown": "0.23.1",
		"typescript": "6.0.3"
	},
	"dependencies": {
		"@clack/prompts": "1.8.1"
	}
}
