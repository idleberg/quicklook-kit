{
	"compilerOptions": {
		"target": "es2023",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2023", "dom"],
		"types": ["vite/client", "quicklook-kit/virtual"],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"isolatedModules": true
	},
	"include": ["src", "vite.config.ts", "quicklook.config.ts"]
}
