{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"formatter": { "indentStyle": "tab", "lineWidth": 100 },
	"javascript": {
		"formatter": { "quoteStyle": "single", "trailingCommas": "all" }
	},
	"html": { "experimentalFullSupportEnabled": true },
	"linter": {
		"rules": {
			"preset": "all",
			"style": {
				"noDefaultExport": "off",
				"useNamingConvention": "off",
				"noTernary": "off",
				"useExportsLast": "off",
				"useGlobalThis": "off",
				"noJsxLiterals": "off",
				"noHeadElement": "off"
			},
			"correctness": {
				"noUnresolvedImports": "off",
				"useImportExtensions": "off"
			},
			"complexity": {
				"noExcessiveLinesPerFunction": "off"
			},
			"performance": {
				// Solid and Svelte components run once; inline handlers aren't re-created.
				"noJsxPropsBind": "off",
				// Vapor mode needs Vue 3.6, which isn't stable yet.
				"useVueVapor": "off"
			}
		},
		"domains": { "astro": "all", "solid": "all", "svelte": "all", "vue": "all" }
	},
	"overrides": [
		{
			"includes": [
				"packages/quicklook-kit/src/cli.ts",
				"packages/quicklook-kit/src/config.ts",
				"packages/quicklook-kit/src/config.test.ts",
				"packages/quicklook-kit/src/vite.ts",
				"packages/quicklook-kit/src/vite.test.ts",
				"packages/create-quicklook/src/index.ts"
			],
			"linter": {
				"rules": {
					"correctness": { "noNodejsModules": "off" },
					"suspicious": { "noConsole": "off" },
					"style": { "noProcessEnv": "off" },
					"performance": { "noAwaitInLoops": "off" }
				}
			}
		},
		{
			// Test fixtures are made of arbitrary values.
			"includes": ["**/*.test.ts"],
			"linter": { "rules": { "style": { "noMagicNumbers": "off" } } }
		},
		{
			// Components are PascalCase; SvelteKit routes start with `+`.
			"includes": ["**/*.svelte", "**/*.vue", "**/components/**"],
			"linter": { "rules": { "style": { "useFilenamingConvention": "off" } } }
		},
		{
			// Solid JSX uses `class`, not `className`. The document renders once and
			// entry-client.tsx mounts into its #app.
			"includes": ["packages/create-quicklook/templates/solid-start/**"],
			"linter": {
				"rules": {
					"suspicious": { "noUnknownAttribute": "off" },
					"correctness": { "useUniqueElementIds": "off" }
				}
			}
		}
	],
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
