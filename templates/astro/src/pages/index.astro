---
import FileViewer from '../components/FileViewer.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<title>Preview</title>
	</head>
	<body>
		<FileViewer />
		<!-- Only reachable in the browser: QuickLook always injects a file. -->
		<label id="drop">
			Drop a file here, or click to pick one
			<input type="file" hidden />
		</label>

		<script>
			import { browserFile, nativeFile, type QuickLookFile } from 'virtual:quicklook';

			const drop = document.querySelector<HTMLLabelElement>('#drop');

			async function show(file: QuickLookFile) {
				await customElements.whenDefined('file-viewer');
				document.querySelector('file-viewer')?.show(file);
				if (drop) {
					drop.hidden = true;
				}
			}

			async function open(files: FileList | null | undefined) {
				const picked = files?.[0];
				if (picked) {
					await show(await browserFile(picked));
				}
			}

			const injected = nativeFile();
			if (injected) {
				show(injected);
			}
			window.addEventListener('dragover', (event) => event.preventDefault());
			window.addEventListener('drop', (event) => {
				event.preventDefault();
				open(event.dataTransfer?.files);
			});
			drop?.querySelector('input')?.addEventListener('change', (event) => {
				open((event.currentTarget as HTMLInputElement).files);
			});
		</script>
	</body>
</html>

<style is:global>
	body {
		margin: 0;
	}

	#drop {
		display: grid;
		place-items: center;
		height: 100vh;
		font: 14px system-ui;
		color: GrayText;
		cursor: pointer;
	}

	#drop[hidden] {
		display: none;
	}
</style>
