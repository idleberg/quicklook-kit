{
	"compilerOptions": {
		"target": "es2023",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2023", "dom"],
		"types": ["vite/client", "quicklook-kit/virtual"],
		"strict": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"useDefineForClassFields": false
	},
	"angularCompilerOptions": { "strictTemplates": true },
	"include": ["src"]
}
